<Project Sdk="Microsoft.NET.Sdk">

  <!-- A2: Core in a self-contained helper process that speaks JSON lines. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>AgentIslandHelper</AssemblyName>
    <RootNamespace>AgentIsland.Bridge.Helper</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <ProjectReference Include="..\..\..\windows\src\AgentIsland.Core\AgentIsland.Core.csproj" />
  </ItemGroup>

</Project>
