<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentIsland.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentIsland.Core\AgentIsland.Core.csproj" />
    <Compile Include="..\..\src\AgentIsland.WinUI\Drawer\HoverCardContentKey.cs" Link="Presentation\HoverCardContentKey.cs" />
    <Compile Include="..\..\src\AgentIsland.WinUI\Drawer\ICharacterEngine.cs" Link="Presentation\ICharacterEngine.cs" />
    <Compile Include="..\..\src\AgentIsland.WinUI\Drawer\V8CharacterEngine.cs" Link="Presentation\V8CharacterEngine.cs" />
  </ItemGroup>

  <!-- The look and theme tests run the shipped engines in V8, as the drawer does. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1" />
  </ItemGroup>

</Project>
