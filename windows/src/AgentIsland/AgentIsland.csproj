<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentIsland</RootNamespace>
    <AssemblyName>AgentIsland</AssemblyName>
    <Version>2.1.2</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon Condition="Exists('Assets\AgentIsland.ico')">Assets\AgentIsland.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <!-- Session scanning, usage, cost and the settings stores live in the
       UI-free core library shared with the WinUI app. -->
  <ItemGroup>
    <ProjectReference Include="..\AgentIsland.Core\AgentIsland.Core.csproj" />
  </ItemGroup>

  <!-- Side drawer characters: embedded V8 runs a locally supplied Grok Bot
       engine copy (never shipped; see UI/Drawer/GrokEngine.cs). Without
       one, the drawer draws simple native characters instead. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1" />
  </ItemGroup>

  <!-- Let the console test suite reach internal validation/parse helpers. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentIsland.Tests" />
  </ItemGroup>

  <!-- WinForms is referenced only for the tray NotifyIcon; keep its
       namespaces out of the global usings so WPF's Color/Size/Application
       win unqualified. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
