<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything below the UI: session scanning and live phases, usage and
       cost, settings stores, localisation. No UI framework: the stores post
       their changes to whichever UI thread the app captures (UiThread), so
       the WinUI app and the tests share this library unchanged. -->
  <PropertyGroup>
    <!-- Cross-platform since the Mac port: net10.0 runs on macOS (and anywhere
         else); the Windows build adds net10.0-windows, which the app and the
         tests pick. Windows-only code sits behind OperatingSystem.IsWindows(). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net10.0-windows</TargetFrameworks>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <!-- The trim and AOT analyzers run in every build, so the NativeAOT dylib (Mac bridge A1) stays free of IL warnings. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentIsland</RootNamespace>
    <AssemblyName>AgentIsland.Core</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Antigravity's conversation_summaries.db. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- Pin the native engine independently of the managed provider's old minimum. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- DeepSeek Harness appends its session log as zstd frames; .NET 8 has
         no zstd codec, so a pure managed one (MIT) reads them. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <!-- Session unlock / resume refreshes. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentIsland.Tests" />
    <InternalsVisibleTo Include="Edgelings" />
  </ItemGroup>

</Project>
