                                <ContentPresenter Content="{TemplateBinding HeaderIcon}" Foreground="{ThemeResource PixelText}" />
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter HorizontalContentAlignment="Stretch" x:Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" Foreground="{ThemeResource PixelText}" TextWrapping="NoWrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                <ContentPresenter HorizontalContentAlignment="Stretch" x:Name="PART_DescriptionPresenter" Content="{TemplateBinding Description}" Foreground="{ThemeResource PixelText2}" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                            </StackPanel>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="2" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Foreground="{ThemeResource PixelText}" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                            <Viewbox x:Name="PART_ActionIconPresenterHolder" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <shell:FixedStyleSelector x:Key="PixelExpanderItemSelector" Style="{StaticResource PixelExpanderItemStyle}" />

    <!-- The expander's header: the whole row toggles; the chevron sits in a 32-DIP square. -->
    <Style x:Key="PixelExpanderHeaderStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PixelPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" Padding="16,14,8,14" ColumnSpacing="8">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource PixelHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource PixelPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource PixelHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource PixelPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" />
                        <Grid x:Name="ChevronBox" Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center" Background="Transparent" Control.IsTemplateFocusTarget="True">
                            <Path x:Name="Down" Width="20" Height="20" Fill="{ThemeResource PixelText2}" Data="M2,6h2v2h-2zM16,6h2v2h-2zM4,8h2v2h-2zM14,8h2v2h-2zM6,10h2v2h-2zM12,10h2v2h-2zM8,12h4v2h-4z" />
                            <Path x:Name="Up" Width="20" Height="20" Visibility="Collapsed" Fill="{ThemeResource PixelText2}" Data="M8,6h4v2h-4zM6,8h2v2h-2zM12,8h2v2h-2zM4,10h2v2h-2zM14,10h2v2h-2zM2,12h2v2h-2zM16,12h2v2h-2z" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PixelSettingsExpanderStyle" TargetType="tk:SettingsExpander">
        <Setter Property="shell:ExpanderMotion.Enabled" Value="True" />
        <Setter Property="Background" Value="{ThemeResource PixelPaper}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLine}" />
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemContainerStyleSelector" Value="{StaticResource PixelExpanderItemSelector}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tk:SettingsExpander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <shell:PixelSurface Grid.RowSpan="2" Fill="{TemplateBinding Background}" Outline="{TemplateBinding BorderBrush}" />
                        <ToggleButton Style="{StaticResource PixelExpanderHeaderStyle}" MinHeight="68" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding HeaderIcon}" Foreground="{ThemeResource PixelText}" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter HorizontalContentAlignment="Stretch" Content="{TemplateBinding Header}" Foreground="{ThemeResource PixelText}" TextWrapping="NoWrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                    <ContentPresenter HorizontalContentAlignment="Stretch" Content="{TemplateBinding Description}" Foreground="{ThemeResource PixelText2}" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{ThemeResource PixelText}" />
                            </Grid>
                        </ToggleButton>
                        <!-- Rows: ExpanderMotion shows, opens and closes them (M9), keeping the outline's
                             cell clear part way, as their bottom margin does at rest. -->
                        <shell:RevealPanel x:Name="Rows" Grid.Row="1" Visibility="Collapsed" Hem="2">
                            <StackPanel Margin="0,0,0,2">
                                <ContentPresenter Content="{TemplateBinding ItemsHeader}" />
                                <ItemsRepeater x:Name="PART_ItemsRepeater" TabFocusNavigation="Local">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <ContentPresenter Content="{TemplateBinding ItemsFooter}" />
                            </StackPanel>
                        </shell:RevealPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="tk:SettingsExpander" BasedOn="{StaticResource PixelSettingsExpanderStyle}" />

    <!-- Settings' page list: 40-DIP rows; the open page sits on paper with an accent bar. -->
    <Style x:Key="PixelNavItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PixelDesk}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" MinHeight="{TemplateBinding MinHeight}" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource PixelHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource PixelPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Chosen.Visibility" Value="Visible" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Chosen.Visibility" Value="Visible" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Chosen.Visibility" Value="Visible" />
                                        <Setter Target="Chosen.Fill" Value="{ThemeResource PixelPressed}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <shell:PixelSurface x:Name="Chosen" Shape="Control" Visibility="Collapsed" Fill="{ThemeResource PixelPaper}" Outline="{ThemeResource PixelLine}" />
                        <Rectangle x:Name="Bar" Visibility="Collapsed" Width="4" Height="16" Margin="6,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource PixelAccent}" />
                        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Foreground="{ThemeResource PixelText}" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down lists: a notched field with a pixel chevron; the list opens over it on a surface,
         one cell inside its outline, the selected item's text on the box's (4 + 8 = 12). -->
    <Style x:Key="PixelComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="LayoutRoot" MinHeight="{TemplateBinding MinHeight}" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource PixelHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource PixelPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource PixelAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource PixelAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource PixelAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource PixelAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource PixelAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="InputModeStates">
                                <VisualState x:Name="InputModeDefault" />
                                <VisualState x:Name="TouchInputMode" />
                                <VisualState x:Name="GameControllerInputMode" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="Bar" Visibility="Collapsed" Width="4" Height="16" HorizontalAlignment="Left" Fill="{ThemeResource PixelAccent}" />
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PixelComboBoxItemStyle}" />

    <!-- A drop-down list: a surface with a hard shadow behind the scrolling items. -->
    <Style x:Key="PixelDropDownScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <!-- Plate: M13's ghosts are this plate at the selected row, then half way. -->
                        <shell:PixelSurface x:Name="Plate" Fill="{ThemeResource PixelPaper}" Outline="{ThemeResource PixelLine}" HardShadow="{ThemeResource PixelShadow}" />
                        <ScrollContentPresenter x:Name="ScrollContentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="VerticalScrollBar" Margin="0,4,4,6" HorizontalAlignment="Right" Orientation="Vertical" IsTabStop="False" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PixelComboBoxStyle" TargetType="ComboBox">
        <Setter Property="shell:ControlMotion.DropDown" Value="True" />
        <Setter Property="Padding" Value="12,0,36,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MaxDropDownHeight" Value="504" />
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="Background" Value="{ThemeResource PixelField}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLineControl}" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="True" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PixelPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PixelComboBoxItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <CarouselPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="LayoutRoot">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Background.Fill" Value="{ThemeResource PixelFieldHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Background.Fill" Value="{ThemeResource PixelFieldPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Background.Fill" Value="{ThemeResource PixelDisabledFill}" />
                                        <Setter Target="Background.Outline" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="DropDownGlyph.Fill" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="FocusedPressed" />
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="FocusedDropDown" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DropDownStates">
                                <VisualState x:Name="Opened" />
                                <VisualState x:Name="Closed" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource PixelText}" Margin="0,0,0,8" Visibility="Collapsed" x:DeferLoadStrategy="Lazy" />
                        <shell:PixelSurface x:Name="Background" Grid.Row="1" Shape="Control" Fill="{TemplateBinding Background}" Outline="{TemplateBinding BorderBrush}" Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter x:Name="ContentPresenter" Grid.Row="1" MinHeight="{TemplateBinding MinHeight}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" VerticalContentAlignment="Center" LineHeight="20" LineStackingStrategy="BlockLineHeight">
                            <TextBlock x:Name="PlaceholderTextBlock" Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource PixelText3}" />
                        </ContentPresenter>
                        <Path x:Name="DropDownGlyph" Grid.Row="1" Width="20" Height="20" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Fill="{ThemeResource PixelText2}" Data="M2,6h2v2h-2zM16,6h2v2h-2zM4,8h2v2h-2zM14,8h2v2h-2zM6,10h2v2h-2zM12,10h2v2h-2zM8,12h4v2h-4z" />
                        <ContentPresenter x:Name="DescriptionPresenter" Grid.Row="2" Content="{TemplateBinding Description}" Foreground="{ThemeResource PixelText2}" x:Load="False" />
                        <!-- The ComboBox finds its list as PopupBorder > ScrollViewer > items; its
                             click-outside-to-close and placement depend on exactly that, so the
                             pixel plate lives in the ScrollViewer's template. The list's inset is
                             the ItemsPresenter's margin, the one WinUI allows for when it centres
                             the selected item on the box; at the bottom the last item's own
                             2-DIP margin is the gutter, so 4 there against 6 at the right. -->
                        <Popup x:Name="Popup">
                            <Border x:Name="PopupBorder" HorizontalAlignment="Stretch" Background="Transparent">
                                <ScrollViewer x:Name="ScrollViewer" Style="{StaticResource PixelDropDownScrollViewerStyle}" Foreground="{ThemeResource PixelText}" MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.DropDownContentMinWidth}" VerticalSnapPointsType="OptionalSingle" VerticalSnapPointsAlignment="Near" HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}" IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}" IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}" BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw">
                                    <ItemsPresenter Margin="4,4,6,4" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource PixelComboBoxStyle}" />

    <!-- Text boxes: a notched field whose outline turns to the accent while typing. -->
    <Style x:Key="PixelTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="Background" Value="{ThemeResource PixelField}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLineControl}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PixelPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelDisabledFill}" />
                                        <Setter Target="Frame.Outline" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="ContentElement.Foreground" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelFieldHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Outline" Value="{ThemeResource PixelAccent}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ButtonStates">
                                <VisualState x:Name="ButtonVisible" />
                                <VisualState x:Name="ButtonCollapsed" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
