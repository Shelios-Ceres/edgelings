<?xml version="1.0" encoding="utf-8"?>
<!--
    The pixel kit for Settings, the Cost window and the drawer menu, used while
    Character style is Pixel. Shapes sit on the 2-DIP grid through
    PixelSurface; colours are the "Pixel*" tokens PixelTheme adds per theme.
-->
<ResourceDictionary
    x:Class="AgentIsland.WinUI.Shell.PixelTheme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:AgentIsland.WinUI.Shell"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <shell:VisibleWhenTrue x:Key="PixelVisibleWhenTrue" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="PixelBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="PixelSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelBodyTextStyle}">
        <Setter Property="FontSize" Value="{ThemeResource PixelSubtitleSize}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style x:Key="PixelTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelBodyTextStyle}">
        <Setter Property="FontSize" Value="{ThemeResource PixelTitleSize}" />
        <Setter Property="LineHeight" Value="36" />
    </Style>

    <!-- The window on desk; content panels on layer. -->
    <Style x:Key="PixelWindowStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource PixelDesk}" />
    </Style>
    <Style x:Key="PixelLayerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PixelLayer}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLineSoft}" />
        <Setter Property="BorderThickness" Value="2,2,0,0" />
    </Style>
    <Style x:Key="PixelFrameStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLine}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Buttons: a notched control on field, with a ledge until pressed. -->
    <Style x:Key="PixelButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PixelField}" />
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLineControl}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PixelPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelFieldHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelFieldPressed}" />
                                        <Setter Target="Frame.Ledge" Value="{x:Null}" />
                                        <Setter Target="Lift.Y" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelDisabledFill}" />
                                        <Setter Target="Frame.Outline" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="Frame.Ledge" Value="{x:Null}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <shell:PixelSurface x:Name="Frame" Shape="Control" Fill="{TemplateBinding Background}" Outline="{TemplateBinding BorderBrush}" Ledge="{ThemeResource PixelFieldPressed}" />
                        <ContentPresenter x:Name="ContentPresenter" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" LineHeight="20" LineStackingStrategy="BlockLineHeight" AutomationProperties.AccessibilityView="Raw">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="Lift" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}" />

    <Style x:Key="PixelAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource PixelAccent}" />
        <Setter Property="Foreground" Value="{ThemeResource PixelOnAccent}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelAccentDeep}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelAccentHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelAccentPressed}" />
                                        <Setter Target="Frame.Ledge" Value="{x:Null}" />
                                        <Setter Target="Lift.Y" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelDisabledFill}" />
                                        <Setter Target="Frame.Outline" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="Frame.Ledge" Value="{x:Null}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <shell:PixelSurface x:Name="Frame" Shape="Control" Fill="{TemplateBinding Background}" Outline="{TemplateBinding BorderBrush}" Ledge="{ThemeResource PixelAccentDeep}" />
                        <ContentPresenter x:Name="ContentPresenter" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" LineHeight="20" LineStackingStrategy="BlockLineHeight" AutomationProperties.AccessibilityView="Raw">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="Lift" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The order list's arrows: a button 36 by 28 around a 20-DIP icon. -->
    <Style x:Key="PixelIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PixelDropDownButtonStyle" TargetType="DropDownButton">
        <Setter Property="Background" Value="{ThemeResource PixelField}" />
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLineControl}" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PixelPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelFieldHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelFieldPressed}" />
                                        <Setter Target="Frame.Ledge" Value="{x:Null}" />
                                        <Setter Target="Lift.Y" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Fill" Value="{ThemeResource PixelDisabledFill}" />
                                        <Setter Target="Frame.Outline" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="Frame.Ledge" Value="{x:Null}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="Chevron.Fill" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <shell:PixelSurface x:Name="Frame" Shape="Control" Fill="{TemplateBinding Background}" Outline="{TemplateBinding BorderBrush}" Ledge="{ThemeResource PixelFieldPressed}" />
                        <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift" />
                            </Grid.RenderTransform>
                            <ContentPresenter x:Name="ContentPresenter" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" LineHeight="20" LineStackingStrategy="BlockLineHeight" AutomationProperties.AccessibilityView="Raw" />
                            <Path x:Name="Chevron" Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center" Fill="{ThemeResource PixelText2}" Data="M2,6h2v2h-2zM16,6h2v2h-2zM4,8h2v2h-2zM14,8h2v2h-2zM6,10h2v2h-2zM12,10h2v2h-2zM8,12h4v2h-4z" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DropDownButton" BasedOn="{StaticResource PixelDropDownButtonStyle}" />

    <!-- Toggle: "Off" or "On", then a notched 40 x 20 track with a square knob. -->
    <Style x:Key="PixelToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="shell:ControlMotion.Switch" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="ManipulationMode" Value="System,TranslateX" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PixelAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PixelPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Background="Transparent" ColumnSpacing="12">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource PixelFieldHover}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource PixelAccentHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchKnobOff.Width" Value="16" />
                                        <Setter Target="SwitchKnobOn.Width" Value="16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource PixelDisabledFill}" />
                                        <Setter Target="OuterBorder.Outline" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="SwitchKnobBounds.Outline" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="SwitchKnobOn.Fill" Value="{ThemeResource PixelPaper}" />
                                        <Setter Target="OffContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                        <Setter Target="OnContentPresenter.Foreground" Value="{ThemeResource PixelDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <!-- M12 flip: the knob steps 20 DIP on in3 (its left edge at 14, 20, 24, or
                                     back at 14, 8, 4); the track and knob recolour on frame 2. -->
                                <VisualStateGroup.Transitions>
                                    <VisualTransition x:Name="OffToOnTransition" From="Off" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0333" Value="10" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="16" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1000" Value="20" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToOffTransition" From="On" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="20" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0333" Value="10" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1000" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0000" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0667" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Target="KnobTranslateTransform.X" Value="20" />
                                        <Setter Target="SwitchKnobBounds.Opacity" Value="1" />
                                        <Setter Target="OuterBorder.Opacity" Value="0" />
                                        <Setter Target="SwitchKnobOn.Opacity" Value="1" />
                                        <Setter Target="SwitchKnobOff.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent">
                                    <VisualState.Setters>
                                        <Setter Target="OffContentPresenter.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="OnContent">
                                    <VisualState.Setters>
                                        <Setter Target="OnContentPresenter.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                        <ContentPresenter x:Name="OffContentPresenter" Opacity="0" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center" LineHeight="20" LineStackingStrategy="BlockLineHeight" AutomationProperties.AccessibilityView="Raw" />
                        <ContentPresenter x:Name="OnContentPresenter" Opacity="0" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center" LineHeight="20" LineStackingStrategy="BlockLineHeight" AutomationProperties.AccessibilityView="Raw" />
                        <Grid x:Name="SwitchAreaGrid" Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center" Background="Transparent" Control.IsTemplateFocusTarget="True">
                            <shell:PixelSurface x:Name="OuterBorder" Shape="Control" Fill="{ThemeResource PixelField}" Outline="{ThemeResource PixelLineControl}" />
                            <shell:PixelSurface x:Name="SwitchKnobBounds" Shape="Control" Opacity="0" Fill="{ThemeResource PixelAccent}" Outline="{ThemeResource PixelAccentDeep}" />
                            <Grid x:Name="SwitchKnob" Width="20" Height="20" HorizontalAlignment="Left">
                                <Rectangle x:Name="SwitchKnobOff" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{ThemeResource PixelText2}" />
                                <Rectangle x:Name="SwitchKnobOn" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,4,0" Opacity="0" Fill="{ThemeResource PixelKnobOn}" />
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" />
                                </Grid.RenderTransform>
                            </Grid>
                        </Grid>
                        <Thumb x:Name="SwitchThumb" Grid.ColumnSpan="2" AutomationProperties.AccessibilityView="Raw">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PixelToggleSwitchStyle}" />

    <!-- Setting cards: a stepped surface; icon, title and description, then the control. -->
    <Style x:Key="PixelSettingsCardStyle" TargetType="tk:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource PixelPaper}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PixelLine}" />
        <Setter Property="Foreground" Value="{ThemeResource PixelText}" />
        <Setter Property="Padding" Value="16,14,16,14" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{ThemeResource PixelFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PixelBodySize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tk:SettingsCard">
                    <Grid MinHeight="{TemplateBinding MinHeight}">
                        <shell:PixelSurface Fill="{TemplateBinding Background}" Outline="{TemplateBinding BorderBrush}" />
                        <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox x:Name="PART_HeaderIconPresenterHolder" Width="20" Height="20" VerticalAlignment="Center">
                                <ContentPresenter Content="{TemplateBinding HeaderIcon}" Foreground="{ThemeResource PixelText}" />
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter HorizontalContentAlignment="Stretch" x:Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" Foreground="{ThemeResource PixelText}" TextWrapping="NoWrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                <ContentPresenter HorizontalContentAlignment="Stretch" x:Name="PART_DescriptionPresenter" Content="{TemplateBinding Description}" Foreground="{ThemeResource PixelText2}" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                            </StackPanel>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="2" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Foreground="{ThemeResource PixelText}" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                            <Viewbox x:Name="PART_ActionIconPresenterHolder" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="tk:SettingsCard" BasedOn="{StaticResource PixelSettingsCardStyle}" />

    <!-- The Order card: its list below the title rather than beside it. -->
    <Style x:Key="PixelSettingsCardVerticalStyle" TargetType="tk:SettingsCard" BasedOn="{StaticResource PixelSettingsCardStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tk:SettingsCard">
                    <Grid MinHeight="{TemplateBinding MinHeight}">
                        <shell:PixelSurface Fill="{TemplateBinding Background}" Outline="{TemplateBinding BorderBrush}" />
                        <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox x:Name="PART_HeaderIconPresenterHolder" Width="20" Height="20" VerticalAlignment="Center">
                                <ContentPresenter Content="{TemplateBinding HeaderIcon}" Foreground="{ThemeResource PixelText}" />
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter HorizontalContentAlignment="Stretch" x:Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" Foreground="{ThemeResource PixelText}" TextWrapping="NoWrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                <ContentPresenter HorizontalContentAlignment="Stretch" x:Name="PART_DescriptionPresenter" Content="{TemplateBinding Description}" Foreground="{ThemeResource PixelText2}" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                            </StackPanel>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="1" Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" Foreground="{ThemeResource PixelText}" />
                            <Viewbox x:Name="PART_ActionIconPresenterHolder" Visibility="Collapsed" />
                        </Grid>
