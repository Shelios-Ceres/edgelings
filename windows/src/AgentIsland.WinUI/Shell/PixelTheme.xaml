    <!-- A row inside an opened expander: a dashed rule above, its icon under the header text. -->
    <Style x:Key="PixelExpanderItemStyle" TargetType="tk:SettingsCard" BasedOn="{StaticResource PixelSettingsCardStyle}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="52,10,16,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tk:SettingsCard">
                    <Grid MinHeight="{TemplateBinding MinHeight}">
                        <shell:PixelRule VerticalAlignment="Top" Margin="2,0,2,0" Fill="{ThemeResource PixelLineSoft}" />
                        <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
