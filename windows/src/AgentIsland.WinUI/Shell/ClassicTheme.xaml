<?xml version="1.0" encoding="utf-8"?>
<!--
    The Classic kit for Settings, the Cost window and the drawer menu, used while
    Character style is Classic: Fluent's controls in softer shapes, ink on paper
    with the Sky accent (windows/notes/classic-grok-20261015). Colours are the
    "Classic*" tokens ClassicTheme adds per theme, with the Fluent keys the
    lightly styled controls read.
-->
<ResourceDictionary
    x:Class="AgentIsland.WinUI.Shell.ClassicTheme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:AgentIsland.WinUI.Shell"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <shell:VisibleWhenTrue x:Key="ClassicVisibleWhenTrue" />

    <Style x:Key="ClassicHeroTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <!-- The page sits on the layer: its top-left corner rounds into the nav pane. -->
    <Style x:Key="ClassicLayerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ClassicLayer}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ClassicLineSoft}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="CornerRadius" Value="16,0,0,0" />
    </Style>

    <!-- Buttons: Fluent's, as pills on field with the card edge. -->
    <Style x:Key="ClassicButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,5,16,6" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}" />

    <Style x:Key="ClassicAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,5,16,6" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
    </Style>

    <!-- The order list's arrows: 36 by 28 pills around a 14-DIP glyph. -->
    <Style x:Key="ClassicIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="ClassicDropDownButtonStyle" TargetType="DropDownButton">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,5,12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
    </Style>
    <Style TargetType="DropDownButton" BasedOn="{StaticResource ClassicDropDownButtonStyle}" />

    <!-- Toggle: the label, then a 44 x 24 pill whose knob wears the dot bot's eyes,
         asleep while off and awake, looking along, while on. Fluent's slide stays. -->
    <Style x:Key="ClassicToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource ClassicText}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ManipulationMode" Value="System,TranslateX" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Background="Transparent" ColumnSpacing="12">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="18" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="18" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="18" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="18" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ClassicFieldHover}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ClassicAccentHover}" />
                                        <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ClassicAccentHover}" />
                                        <Setter Target="OnEyes.Spacing" Value="3" />
                                        <Setter Target="OffEyes.Spacing" Value="3" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="20" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="20" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="20" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="20" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ClassicFieldHover}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ClassicAccentPressed}" />
                                        <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ClassicAccentPressed}" />
                                        <Setter Target="SwitchKnobOn.HorizontalAlignment" Value="Right" />
                                        <Setter Target="SwitchKnobOn.Margin" Value="0,0,3,0" />
                                        <Setter Target="SwitchKnobOff.HorizontalAlignment" Value="Left" />
                                        <Setter Target="SwitchKnobOff.Margin" Value="3,0,0,0" />
                                        <Setter Target="OnEyes.Spacing" Value="3" />
                                        <Setter Target="OffEyes.Spacing" Value="3" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="23" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="18" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="23" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="18" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ClassicDisabledFill}" />
                                        <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ClassicDisabled}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ClassicDisabled}" />
                                        <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ClassicDisabled}" />
                                        <Setter Target="SwitchKnobOff.Background" Value="{ThemeResource ClassicDisabled}" />
                                        <Setter Target="SwitchKnobOn.Background" Value="{ThemeResource ClassicPaper}" />
                                        <Setter Target="OnEyeLeft.Height" Value="1.5" />
                                        <Setter Target="OnEyeRight.Height" Value="1.5" />
                                        <Setter Target="OnEyeLeft.Fill" Value="{ThemeResource ClassicDisabledFill}" />
                                        <Setter Target="OnEyeRight.Fill" Value="{ThemeResource ClassicDisabledFill}" />
                                        <Setter Target="OffEyeLeft.Fill" Value="{ThemeResource ClassicDisabledFill}" />
                                        <Setter Target="OffEyeRight.Fill" Value="{ThemeResource ClassicDisabledFill}" />
                                        <Setter Target="OffContentPresenter.Foreground" Value="{ThemeResource ClassicDisabled}" />
                                        <Setter Target="OnContentPresenter.Foreground" Value="{ThemeResource ClassicDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition x:Name="DraggingToOnTransition" From="Dragging" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOnOffset}" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToDraggingTransition" From="On" To="Dragging" GeneratedDuration="0">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="0" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="DraggingToOffTransition" From="Dragging" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOffOffset}" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToOffTransition" From="On" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOnToOffOffset}" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OffToOnTransition" From="Off" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOffToOnOffset}" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="20" Duration="0" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="{StaticResource ControlFasterAnimationDuration}" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent">
                                    <VisualState.Setters>
                                        <Setter Target="OffContentPresenter.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="OnContent">
                                    <VisualState.Setters>
                                        <Setter Target="OnContentPresenter.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                        <ContentPresenter x:Name="OffContentPresenter" Opacity="0" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <ContentPresenter x:Name="OnContentPresenter" Opacity="0" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <Grid x:Name="SwitchAreaGrid" Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center" Background="Transparent" CornerRadius="12" Control.IsTemplateFocusTarget="True">
                            <Rectangle x:Name="OuterBorder" RadiusX="12" RadiusY="12" Fill="{ThemeResource ClassicField}" Stroke="{ThemeResource ClassicLineControl}" StrokeThickness="1" />
                            <Rectangle x:Name="SwitchKnobBounds" RadiusX="12" RadiusY="12" Opacity="0" Fill="{ThemeResource ClassicAccent}" Stroke="{ThemeResource ClassicAccent}" StrokeThickness="1" />
                            <Grid x:Name="SwitchKnob" Width="24" Height="24" HorizontalAlignment="Left">
                                <Border x:Name="SwitchKnobOn" Width="18" Height="18" CornerRadius="12" Opacity="0" Background="{ThemeResource ClassicOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel x:Name="OnEyes" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform X="1" />
                                        </StackPanel.RenderTransform>
                                        <Rectangle x:Name="OnEyeLeft" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource ClassicAccent}" />
                                        <Rectangle x:Name="OnEyeRight" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource ClassicAccent}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SwitchKnobOff" Width="18" Height="18" CornerRadius="12" Background="{ThemeResource ClassicText2}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel x:Name="OffEyes" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1.5,0,0">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform X="-1" />
                                        </StackPanel.RenderTransform>
                                        <Rectangle x:Name="OffEyeLeft" Width="3" Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="{ThemeResource ClassicPaper}" />
                                        <Rectangle x:Name="OffEyeRight" Width="3" Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="{ThemeResource ClassicPaper}" />
                                    </StackPanel>
                                </Border>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" />
                                </Grid.RenderTransform>
                            </Grid>
                        </Grid>
                        <Thumb x:Name="SwitchThumb" Grid.ColumnSpan="2" AutomationProperties.AccessibilityView="Raw">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource ClassicToggleSwitchStyle}" />

    <!-- Setting cards: paper with a hairline and a lip; the glyph in a 32-DIP puck
         (an agent's tinted by Puck.SetTint, through Tag), the title and description, then the control. -->
    <Style x:Key="ClassicSettingsCardStyle" TargetType="tk:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ClassicEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource ClassicText}" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tk:SettingsCard">
                    <Grid MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" ColumnSpacing="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" BackgroundSizing="InnerBorderEdge">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="PART_HeaderIconPresenterHolder" Width="32" Height="32" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource ClassicField}" />
                            <Ellipse Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Content="{TemplateBinding HeaderIcon}" Foreground="{ThemeResource ClassicText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ContentPresenter x:Name="PART_HeaderPresenter" HorizontalContentAlignment="Stretch" Content="{TemplateBinding Header}" Foreground="{ThemeResource ClassicText}" TextWrapping="NoWrap" LineHeight="20" />
                            <ContentPresenter x:Name="PART_DescriptionPresenter" HorizontalContentAlignment="Stretch" Content="{TemplateBinding Description}" Foreground="{ThemeResource ClassicText2}" FontSize="12" LineHeight="16" TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="2" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Foreground="{ThemeResource ClassicText}" />
                        <Viewbox x:Name="PART_ActionIconPresenterHolder" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="tk:SettingsCard" BasedOn="{StaticResource ClassicSettingsCardStyle}" />

    <!-- The Order card: its list under the title, in the text column. -->
    <Style x:Key="ClassicSettingsCardVerticalStyle" TargetType="tk:SettingsCard" BasedOn="{StaticResource ClassicSettingsCardStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tk:SettingsCard">
                    <Grid MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" ColumnSpacing="16" RowSpacing="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" BackgroundSizing="InnerBorderEdge">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="PART_HeaderIconPresenterHolder" Width="32" Height="32" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource ClassicField}" />
                            <ContentPresenter Content="{TemplateBinding HeaderIcon}" Foreground="{ThemeResource ClassicText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ContentPresenter x:Name="PART_HeaderPresenter" HorizontalContentAlignment="Stretch" Content="{TemplateBinding Header}" Foreground="{ThemeResource ClassicText}" TextWrapping="NoWrap" LineHeight="20" />
                            <ContentPresenter x:Name="PART_DescriptionPresenter" HorizontalContentAlignment="Stretch" Content="{TemplateBinding Description}" Foreground="{ThemeResource ClassicText2}" FontSize="12" LineHeight="16" TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="1" Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" Foreground="{ThemeResource ClassicText}" />
                        <Viewbox x:Name="PART_ActionIconPresenterHolder" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row inside an opened expander: a soft rule from the text column, a plain
         16-DIP icon in text2 (a 24-DIP puck for an agent), its control on the
         header's control line. -->
    <Style x:Key="ClassicExpanderItemStyle" TargetType="tk:SettingsCard" BasedOn="{StaticResource ClassicSettingsCardStyle}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="64,8,58,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tk:SettingsCard">
                    <Grid MinHeight="{TemplateBinding MinHeight}">
                        <Rectangle Height="1" Margin="64,0,0,0" VerticalAlignment="Top" Fill="{ThemeResource ClassicLineSoft}" />
                        <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="14">
