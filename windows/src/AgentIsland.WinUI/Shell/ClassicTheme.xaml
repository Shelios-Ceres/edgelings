                            </StackPanel>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="2" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Foreground="{ThemeResource ClassicText}" />
                            <Viewbox x:Name="PART_ActionIconPresenterHolder" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <shell:FixedStyleSelector x:Key="ClassicExpanderItemSelector" Style="{StaticResource ClassicExpanderItemStyle}" />

    <!-- The expander's header: the whole row toggles; the chevron sits in a 32-DIP pill. -->
    <Style x:Key="ClassicExpanderHeaderStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" Padding="16,12,10,12" ColumnSpacing="16">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource ClassicHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource ClassicPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chevron.Glyph" Value="&#xE70E;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chevron.Glyph" Value="&#xE70E;" />
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource ClassicHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chevron.Glyph" Value="&#xE70E;" />
                                        <Setter Target="ChevronBox.Background" Value="{ThemeResource ClassicPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chevron.Glyph" Value="&#xE70E;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" />
                        <Border x:Name="ChevronBox" Grid.Column="1" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center" Background="Transparent" Control.IsTemplateFocusTarget="True">
                            <FontIcon x:Name="Chevron" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource ClassicText2}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicSettingsExpanderStyle" TargetType="tk:SettingsExpander">
        <Setter Property="Background" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ClassicEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource ClassicText}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemContainerStyleSelector" Value="{StaticResource ClassicExpanderItemSelector}" />
        <Setter Property="Template">
