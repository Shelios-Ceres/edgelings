        <Setter Property="Padding" Value="14,5,0,7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ClassicComboBoxItemStyle}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ClassicPaper}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ClassicComboBoxStyle}" />

    <Style x:Key="ClassicTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,5,14,6" />
