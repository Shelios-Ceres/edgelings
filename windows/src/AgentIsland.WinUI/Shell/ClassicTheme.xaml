    <Style TargetType="tk:SettingsExpander" BasedOn="{StaticResource ClassicSettingsExpanderStyle}" />

    <!-- Order list rows: on field, 36 tall with a 10 radius. Dragged, the row stays
         inside its bounds (the list clips it) on paper with an accent outline; the
         drop point is an accent line with a ring at its start. -->
    <Style x:Key="ClassicOrderRowStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DragStates">
                                <VisualState x:Name="NotDragging" />
                                <VisualState x:Name="Dragging">
                                    <VisualState.Setters>
                                        <Setter Target="Row.Background" Value="{ThemeResource ClassicPaper}" />
                                        <Setter Target="Row.BorderBrush" Value="{ThemeResource ClassicAccent}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="DraggingTarget" />
                                <VisualState x:Name="MultipleDraggingPrimary" />
                                <VisualState x:Name="MultipleDraggingSecondary" />
                                <VisualState x:Name="DraggedPlaceholder">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Reordering">
                                    <VisualState.Setters>
                                        <Setter Target="Row.Background" Value="{ThemeResource ClassicPaper}" />
                                        <Setter Target="Row.BorderBrush" Value="{ThemeResource ClassicAccent}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ReorderingTarget">
                                    <VisualState.Setters>
                                        <Setter Target="DropLine.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MultipleReorderingPrimary" />
                                <VisualState x:Name="ReorderedPlaceholder">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="DragOver">
                                    <VisualState.Setters>
                                        <Setter Target="DropLine.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Row" Background="{ThemeResource ClassicField}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="10" Padding="8.5,0,2.5,0">
                            <ContentPresenter x:Name="RowContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Foreground="{ThemeResource ClassicText}" />
                        </Border>
                        <Grid x:Name="DropLine" Visibility="Collapsed" Height="9" Margin="0,-6.5,0,0" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Rectangle Height="3" Margin="26,0,0,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{ThemeResource ClassicAccent}" />
                            <Ellipse Width="9" Height="9" Margin="21.5,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource ClassicLayer}" Stroke="{ThemeResource ClassicAccent}" StrokeThickness="2" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings' page list: 40-DIP pills 4 apart; the open page on a paper pill that
         lifts off the pane, its label semibold and its icon in the accent. -->
    <Style x:Key="ClassicNavItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="14,0,12,0" />
        <Setter Property="Foreground" Value="{ThemeResource ClassicText}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ClassicDesk}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" MinHeight="{TemplateBinding MinHeight}" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Fill" Value="{ThemeResource ClassicHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Fill" Value="{ThemeResource ClassicPressed}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource ClassicText2}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Fill" Value="{ThemeResource ClassicPaper}" />
                                        <Setter Target="Lift.Visibility" Value="Visible" />
                                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Fill" Value="{ThemeResource ClassicPaper}" />
                                        <Setter Target="Lift.Visibility" Value="Visible" />
                                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Fill" Value="{ThemeResource ClassicPaper}" />
                                        <Setter Target="Lift.Visibility" Value="Visible" />
                                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <shell:SoftShadow x:Name="Lift" Kind="Lift" Visibility="Collapsed" Target="{Binding ElementName=Pill}" />
                        <Rectangle x:Name="Pill" RadiusX="20" RadiusY="20" Fill="Transparent" />
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down lists: Fluent's, as pills; the list on paper with rounded items, the
         chosen one in the accent tint with the accent bar and semibold text. -->
    <Style x:Key="ClassicComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{ThemeResource ClassicText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ClassicAccent}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="LayoutRoot" MinHeight="{TemplateBinding MinHeight}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.167" />
                        </Grid.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ClassicHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ClassicDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ClassicPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ClassicAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ClassicAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ClassicAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ClassicDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ClassicAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ClassicAccentTint}" />
                                        <Setter Target="Bar.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="InputModeStates">
                                <VisualState x:Name="InputModeDefault" />
                                <VisualState x:Name="TouchInputMode" />
                                <VisualState x:Name="GameControllerInputMode" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="Bar" Visibility="Collapsed" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="0,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource ClassicAccent}" />
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ClassicComboBoxItemStyle}" />

    <Style x:Key="ClassicComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
