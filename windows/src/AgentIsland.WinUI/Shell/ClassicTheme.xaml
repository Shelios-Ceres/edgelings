                                    <ContentPresenter HorizontalContentAlignment="Stretch" Content="{TemplateBinding Description}" Foreground="{ThemeResource ClassicText2}" FontSize="12" LineHeight="16" TextWrapping="Wrap" />
                                </StackPanel>
