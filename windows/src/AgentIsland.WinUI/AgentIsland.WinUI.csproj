<Project Sdk="Microsoft.NET.Sdk">

  <!-- Agent Island on WinUI 3 (Windows App SDK, unpackaged, self-contained).
       The drawer draws its characters with Win2D on its own vsync loop; the
       settings, cost and report windows are native WinUI. Everything below
       the UI comes from AgentIsland.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AgentIsland.WinUI</RootNamespace>
    <AssemblyName>AgentIsland.WinUI</AssemblyName>
    <Version>2.1.2</Version>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AgentIsland.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png;Assets\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Drawer\Characters\characters.mjs;Drawer\Characters\classic.mjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*.ttf;Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentIsland.Core\AgentIsland.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- Drawer characters: embedded V8 runs a locally supplied Grok Bot
         engine copy (never shipped). Without one, simple native characters
         are drawn instead. -->
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1" />
  </ItemGroup>

  <!-- An unpackaged publish leaves out the app's own resource index and its
       compiled XAML pages; without them every window fails to load its XAML.
       Add them from the build output. -->
  <Target Name="IncludeXamlInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlOutput Include="$(OutDir)AgentIsland.WinUI.pri;$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_XamlOutput)" RelativePath="$([MSBuild]::MakeRelative('$(OutDir)', '%(_XamlOutput.FullPath)'))" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
